# --- Auth.js (NextAuth v5) ---
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET=

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI:  https://fvbian.com/api/auth/callback/google
# For local dev also add:   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Access control ---
# Comma-separated list of Google account emails that are allowed to log in.
# Everyone else gets rejected at sign-in. Example:
# ALLOWED_EMAILS=fabian.kingfs@gmail.com,friend@example.com
ALLOWED_EMAILS=fabian.kingfs@gmail.com

# --- Watchlist ---
# TMDb API-Key für Film-/Serien-Suche (kostenlos: themoviedb.org → Settings → API).
# Bücher laufen über Google Books (kein Key nötig).
TMDB_API_KEY=

# --- Notizen: Bild-Upload (optional) ---
# Wird von Vercel automatisch gesetzt, wenn ein Blob-Store verbunden ist
# (Vercel → Storage → Blob). Ohne Token bleibt Bild-per-URL möglich.
BLOB_READ_WRITE_TOKEN=
